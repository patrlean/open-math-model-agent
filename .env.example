# Configure at least one model provider. Never commit real API keys.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
# Used by the Kimi K3 describe_image tool even when the main provider is DeepSeek.
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# Optional: enables Brave Search. The app falls back to DuckDuckGo when empty.
BRAVE_SEARCH_API_KEY=
